<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Software Load Record {{ run_id }}</title>
<style>
  :root { --bg:#f7f8fa; --card:#fff; --text:#1d2330; --muted:#5d6678; --line:#dfe3ea;
          --ok:#1a7f37; --ok-bg:#e6f4ea; --bad:#c62828; --bad-bg:#fdecea; --warn:#8a6d00; --warn-bg:#fff6d6; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#14171c; --card:#1c2027; --text:#e6e9ef; --muted:#9aa3b2; --line:#2e343e;
            --ok:#5fd47e; --ok-bg:#16301f; --bad:#ff7b72; --bad-bg:#3a1a1a; --warn:#e3c55a; --warn-bg:#332b0f; }
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif; }
  main { max-width:1150px; margin:0 auto; padding:24px 16px 48px; }
  h1 { font-size:22px; margin:0 0 4px; } h2 { font-size:16px; margin:26px 0 10px; }
  .muted { color:var(--muted); }
  .banner { padding:14px 18px; border-radius:10px; margin:16px 0; font-weight:600; display:flex; gap:14px; flex-wrap:wrap; align-items:center; }
  .banner.PASS { background:var(--ok-bg); color:var(--ok); } .banner.FAIL { background:var(--bad-bg); color:var(--bad); }
  .banner .big { font-size:24px; }
  .wrap { overflow-x:auto; background:var(--card); border:1px solid var(--line); border-radius:10px; }
  table { border-collapse:collapse; width:100%; min-width:760px; }
  th, td { text-align:left; padding:8px 12px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
  tr:last-child td { border-bottom:none; }
  code { font-family:ui-monospace,Consolas,monospace; font-size:12px; overflow-wrap:anywhere; }
  .tag { display:inline-block; padding:1px 8px; border-radius:999px; font-size:12px; font-weight:600; white-space:nowrap; }
  .UPDATED, .ROLLED { background:var(--ok-bg); color:var(--ok); } .ALREADY { background:var(--ok-bg); color:var(--ok); }
  .FAILED { background:var(--bad-bg); color:var(--bad); }
  .INCOMPATIBLE, .NOT { background:var(--warn-bg); color:var(--warn); }
  ol.steps { margin:0; padding-left:18px; font-size:12.5px; }
  .fail { color:var(--bad); } .drift { color:var(--warn); }
</style>
</head>
<body>
<main>
  <h1>Software Load Record</h1>
  <div class="muted">Run {{ run_id }} &middot; {{ generated }}</div>
  <div class="banner {{ verdict }}">
    <span class="big">{{ verdict }}</span>
    <span>{% for outcome, n in counts.items() %}{{ n }} {{ outcome|lower }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</span>
    {% if rollout.halted %}<span>&middot; rollout halted: {{ rollout.halt_reason }}</span>{% endif %}
  </div>

  <h2>Configuration</h2>
  <div class="wrap"><table>
    <tr><th>Operator</th><td>{{ operator }}</td><th>Inventory</th><td><code>{{ inventory }}</code></td></tr>
    <tr><th>Loader</th><td>fleetload {{ tool_version }} (<code>{{ commit }}</code>)</td><th>Run ID</th><td>{{ run_id }}</td></tr>
  </table></div>

  <h2>Images loaded</h2>
  <div class="wrap"><table>
    <thead><tr><th>Component</th><th>Version</th><th>Hardware</th><th>Image SHA-256</th></tr></thead>
    {% for image in images.values() %}
    <tr><td>{{ image.component }}</td><td>{{ image.version }}</td><td>{{ image.hw_compat|join(", ") }}</td><td><code>{{ image.sha256 }}</code></td></tr>
    {% endfor %}
  </table></div>

  <h2>Devices</h2>
  <div class="wrap"><table>
    <thead><tr><th>Device</th><th>Role / HW</th><th>Before</th><th>After</th><th>Outcome</th><th>Steps</th></tr></thead>
    {% for r in rollout.results %}
    <tr>
      <td><strong>{{ r.device }}</strong></td>
      <td>{{ r.role }} / {{ r.hw_rev }}</td>
      <td>{{ r.before or "-" }}</td>
      <td>{{ r.after or "-" }}</td>
      <td><span class="tag {{ r.outcome.split()[0] }}">{{ r.outcome }}</span></td>
      <td>
        {% if r.steps %}<ol class="steps">
        {% for s in r.steps %}<li class="{{ '' if s.ok else 'fail' }}">{{ s.name }} ({{ "%.1f"|format(s.seconds) }} s): {{ s.detail }}</li>{% endfor %}
        </ol>{% else %}<span class="muted">not attempted</span>{% endif %}
        {% for d in r.drift %}<div class="drift">drift: {{ d.key }} expected {{ d.expected }}, found {{ d.actual }}</div>{% endfor %}
      </td>
    </tr>
    {% endfor %}
  </table></div>
</main>
</body>
</html>
